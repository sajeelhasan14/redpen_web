# Which model marks pages: anthropic (default) or openai. Production requires the chosen provider's key.
MARK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5
# Also used for the tutor's voice (/api/speak).
OPENAI_API_KEY=
# OpenAI marking model (MARK_PROVIDER=openai). gpt-6-luna passed the marking suite 54/54, 30/30 on 2026-10-02.
MARK_MODEL_OPENAI=gpt-6-luna
# Reasoning effort for OpenAI checks (lessons always use medium). Verified at low.
MARK_EFFORT_OPENAI=low
DATABASE_URL=
REDIS_URL=
RESEND_API_KEY=
EMAIL_FROM=RedPen Maths <hello@redpenmaths.com>
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to 1 (and redeploy: build-time) once Paddle keys are added; unset = waitlist-only site.
NEXT_PUBLIC_PAYMENTS_ENABLED=
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID=
SESSION_SECRET=
IP_SALT=
SITE_URL=http://localhost:3000
DEMO_DAILY_CAP_GBP=10
DEMO_PER_VISITOR=10
# Daily pence one visitor may spend across checks, lessons and speech.
DEMO_PER_VISITOR_PENCE=40
PASS_CAP=200
COST_CHECK_PENCE=1
COST_LESSON_PENCE=3
COST_SPEAK_PENCE=1
# GBP per million input/output tokens, used to true-up spend from each call's real usage.
# Set these from Anthropic's current published pricing for the model in use (TUTOR_MODEL).
PRICE_IN_PER_MTOK_GBP=3
PRICE_OUT_PER_MTOK_GBP=15
# The same for OpenAI (used when MARK_PROVIDER=openai), from OpenAI's published pricing for
# MARK_MODEL_OPENAI. gpt-6-luna on 2026-10-02: $0.10 input ($0.125 cache write), $0.50 output
# per MTok; converted at a conservative 0.80 GBP/USD (market ~0.755) using the cache-write rate.
PRICE_IN_PER_MTOK_GBP_OPENAI=0.1
PRICE_OUT_PER_MTOK_GBP_OPENAI=0.4
DEMO_DEV_OPEN=
# The marking engine's private SymPy service (services/checker). Locally: npm run checker:dev
CHECKER_URL=http://127.0.0.1:8000
CHECKER_SECRET=dev
CHECKER_TIMEOUT_MS=60000
# Engine model per role; each falls back to MARK_MODEL_OPENAI or TUTOR_MODEL for the provider in use.
ENGINE_MODEL_READER=
ENGINE_MODEL_MATCHER=
ENGINE_MODEL_JUDGE=
ENGINE_EFFORT=low
ENGINE_TIMEOUT_MS=60000
